# Copy this file to .env and fill in your own key.
# .env is gitignored -- never commit real API keys.
#
# Get a free key at https://aistudio.google.com/apikey
#
# Optional: without this key, the AI Concierge automatically falls back to a
# deterministic, rule-based NLU parser and template explanations, so the app
# still runs end-to-end with zero setup. Set the key to enable real Gemini
# calls for natural-language preference extraction and explanations.
GEMINI_API_KEY=

# Optional override of the model used by the AI Concierge.
# GEMINI_MODEL=gemini-flash-lite-latest
